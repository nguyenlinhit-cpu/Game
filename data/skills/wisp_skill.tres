[gd_resource type="Resource" script_class="SkillData" format=3]

[ext_resource type="Script" path="res://systems/resources/skill_data.gd" id="1_skill_data"]
[ext_resource type="Script" path="res://systems/skill_effects/skill_effect.gd" id="2_skill_effect"]
[ext_resource type="Script" path="res://systems/skill_effects/damage_effect.gd" id="3_damage_effect"]
[ext_resource type="Resource" path="res://data/status_effects/wisp_forget.tres" id="4_wisp_forget"]
[ext_resource type="Script" path="res://systems/skill_effects/apply_status_effect.gd" id="5_apply_status_effect"]
[ext_resource type="Resource" path="res://data/status_effects/wisp_weaken.tres" id="6_wisp_weaken"]

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("3_damage_effect")
scaling_stat = 1
multiplier = 0.7
toughness = 20.0

[sub_resource type="Resource" id="Effect_2"]
script = ExtResource("5_apply_status_effect")
status = ExtResource("4_wisp_forget")

[sub_resource type="Resource" id="Effect_3"]
script = ExtResource("5_apply_status_effect")
status = ExtResource("6_wisp_weaken")

[resource]
script = ExtResource("1_skill_data")
id = &"wisp_skill"
name_key = "SKILL_WISP_SKILL"
desc_key = "SKILL_WISP_SKILL_DESC"
kind = 1
target = 0
effects = Array[ExtResource("2_skill_effect")]([SubResource("Effect_1"), SubResource("Effect_2"), SubResource("Effect_3")])
sp_change = -1
energy_gain = 30.0
