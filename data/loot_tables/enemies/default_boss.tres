[gd_resource type="Resource" script_class="LootTable" format=3]

[ext_resource type="Script" path="res://systems/resources/loot_table.gd" id="1_loot_table"]
[ext_resource type="Script" path="res://systems/resources/loot_entry.gd" id="2_loot_entry"]

