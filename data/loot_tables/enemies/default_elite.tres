[gd_resource type="Resource" script_class="LootTable" format=3]

[ext_resource type="Script" path="res://systems/resources/loot_table.gd" id="1_loot_table"]
[ext_resource type="Script" path="res://systems/resources/loot_entry.gd" id="2_loot_entry"]

[sub_resource type="Resource" id="Entry_0"]
script = ExtResource("2_loot_entry")
item_id = &"aether_coin"
min_count = 200
max_count = 300
chance = 1.0
scales_with_difficulty = true

[sub_resource type="Resource" id="Entry_1"]
script = ExtResource("2_loot_entry")
item_id = &"soul_memory_2"
min_count = 2
max_count = 2
chance = 1.0
scales_with_difficulty = false

[sub_resource type="Resource" id="Entry_2"]
script = ExtResource("2_loot_entry")
item_id = &"sigil_team_2"
min_count = 1
max_count = 2
chance = 1.0
scales_with_difficulty = true

[sub_resource type="Resource" id="Entry_3"]
script = ExtResource("2_loot_entry")
item_id = &"crystal_enemy"
min_count = 1
max_count = 1
chance = 0.4
scales_with_difficulty = true

[sub_resource type="Resource" id="First_0"]
script = ExtResource("2_loot_entry")
item_id = &"star_tear"
min_count = 20
max_count = 20
chance = 1.0
scales_with_difficulty = false

[resource]
script = ExtResource("1_loot_table")
id = &"default_elite"
entries = Array[ExtResource("2_loot_entry")]([SubResource("Entry_0"), SubResource("Entry_1"), SubResource("Entry_2"), SubResource("Entry_3")])
first_clear = Array[ExtResource("2_loot_entry")]([SubResource("First_0")])
