[gd_resource type="Resource" script_class="EncounterData" format=3]

[ext_resource type="Script" path="res://systems/resources/encounter_data.gd" id="1_encounter_data"]
[ext_resource type="Resource" path="res://data/enemies/mirror_shade_soul.tres" id="2_mirror_shade_soul"]
[ext_resource type="Script" path="res://systems/resources/encounter_enemy_entry.gd" id="3_encounter_enemy_entry"]
[ext_resource type="Resource" path="res://data/enemies/mute_librarian.tres" id="4_mute_librarian"]
[ext_resource type="Script" path="res://systems/resources/encounter_wave.gd" id="5_encounter_wave"]

[sub_resource type="Resource" id="Entry_w1_1"]
script = ExtResource("3_encounter_enemy_entry")
