skill = ExtResource("8_traveler_skill")
ultimate = ExtResource("9_traveler_ultimate")
talent = SubResource("Talent")
eidolons = Array[ExtResource("6_eidolon_data")]([SubResource("Eidolon_1"), SubResource("Eidolon_2"), SubResource("Eidolon_3"), SubResource("Eidolon_4"), SubResource("Eidolon_5"), SubResource("Eidolon_6")])
