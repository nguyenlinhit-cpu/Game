skill = ExtResource("9_wisp_skill")
ultimate = ExtResource("10_wisp_ultimate")
talent = SubResource("Talent")
eidolons = Array[ExtResource("7_eidolon_data")]([SubResource("Eidolon_1"), SubResource("Eidolon_2"), SubResource("Eidolon_3"), SubResource("Eidolon_4"), SubResource("Eidolon_5"), SubResource("Eidolon_6")])
