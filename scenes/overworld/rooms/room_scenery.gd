class_name RoomScenery
extends Node2D
## Modular painted props are restricted to solid wall cells; the playable floor stays clear.

const THEMES := {
	&"library": {"accent": Color("cfab67"), "rug": Color("753846")},
	&"vault": {"accent": Color("9de6f4"), "rug": Color("46728d")},
	&"furnace": {"accent": Color("f7a557"), "rug": Color("6a4030")},
	&"tower": {"accent": Color("e4d297"), "rug": Color("525a91")},
}
@export var zone: StringName
@export var source_art: Texture2D

func _ready() -> void:
	# Connections fill the unused door gaps after Room._ready().
	queue_redraw.call_deferred()

func _draw() -> void:
	var room := get_parent() as Room
	if room == null or not THEMES.has(zone) or source_art == null:
		return
	var accent: Color = THEMES[zone]["accent"]
	var half := room.get_half_extent()
	var variant := String(room.room_id).substr(1).to_int()
	var inner := Rect2(Vector2(-half + Vector2i.ONE) * 64, Vector2(room.size_tiles - Vector2i.ONE * 2) * 64)
	draw_rect(inner.grow(-9), Color(accent, 0.45), false, 2)
	for i in room.decorative_bays.size():
		var corner := room.decorative_bays[i]
		var prop := (variant + i + room.room_type) % 8
		var size := source_art.get_size() / 4.0
		var source := Rect2(Vector2(prop % 4, 2 + prop / 4) * size, size)
		# Two-by-two installations have matching solid cells generated by build_world.
		draw_texture_rect_region(source_art, Rect2(Vector2(corner * 64), Vector2.ONE * 128), source)
	# Alternate bays, furnishings and perimeter trim give each area its own arrangement.
	for x in range(-half.x + 1, half.x, 2):
		if absi(x) <= 2:
			continue
		_prop(Vector2i(x, -half.y), (absi(x) + variant + room.room_type) % 8)
		if room.room_type in [Room.RoomType.CHEST, Room.RoomType.BOSS, Room.RoomType.PUZZLE] or variant % 2 == 0:
			_prop(Vector2i(x, half.y), (absi(x) + variant + 3) % 8)
	for y in range(-half.y + 1, half.y, 2):
		if absi(y) <= 2:
			continue
		_prop(Vector2i(-half.x, y), (absi(y) + variant + 2) % 8)
		_prop(Vector2i(half.x, y), (absi(y) + variant + 5) % 8)
	# Puzzle niche walls are solid too, but leave their treasure openings visible.
	if room.room_type == Room.RoomType.PUZZLE:
		for cell in room.wall_layer.get_used_cells():
			if absi(cell.x) < half.x and absi(cell.y) < half.y and (cell.x + variant) % 3 == 0:
				_prop(cell, 4)
	# Flat markings differentiate boss / elite / sanctuary floors without fake obstacles.
	if room.room_type in [Room.RoomType.BOSS, Room.RoomType.ELITE, Room.RoomType.REST]:
		var radius := 88.0 if room.room_type == Room.RoomType.REST else 160.0
		var center := Vector2.ONE * 32
		draw_arc(center, radius, 0, TAU, 64, Color(accent, 0.45), 3, true)
		if zone == &"tower":
			for i in 8:
				var point := center + Vector2.from_angle(i * TAU / 8) * radius
				draw_circle(point, 4, accent)

func _prop(cell: Vector2i, index: int) -> void:
	var room := get_parent() as Room
	if room.wall_layer.get_cell_source_id(cell) < 0:
		return
	var size := source_art.get_size() / 4.0
	var source := Rect2(Vector2(index % 4, 2 + index / 4) * size, size)
	# Never extend onto a traversable neighbor: picture and collision share the same cell.
	draw_texture_rect_region(source_art, Rect2(Vector2(cell * 64), Vector2.ONE * 64), source)
